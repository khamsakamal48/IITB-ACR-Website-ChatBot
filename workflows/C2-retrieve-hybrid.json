          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "embedcfg",
      "name": "Embed Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        208,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $json.data[0].embedding;\nconst query = $('Retrieve Trigger').first().json.query;\nreturn [{ json: { query, vec: '[' + e.join(',') + ']' } }];"
      },
      "id": "buildvec",
      "name": "Build Vector Literal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SET search_path TO acr_website_chatbot;\nSELECT content, metadata->>'url' AS url, metadata->>'title' AS title, metadata->>'section_heading' AS section, metadata->>'modified' AS modified, score FROM hybrid_search($1, $2::vector, 5, 30, 50, 0.01, '{}'::jsonb);",
        "options": {
          "queryReplacement": "={{ [ $json.query, $json.vec ] }}"
        }
      },
      "id": "search",
      "name": "Hybrid Search",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        800,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "uM0P1pO2vip8g5GB",
          "name": "Supabase - IT Ops - ACR Website Chatbot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length || !rows[0].content) return [{ json: { response: 'No relevant knowledge base entries found.', urls: [] } }];\nconst out = rows.map(r => `Source: ${r.title || ''}${r.section ? ' — ' + r.section : ''}\\nURL: ${r.url || ''}\\nUpdated: ${r.modified || 'n/a'}\\n${r.content}`).join('\\n\\n---\\n\\n');\nconst urls = rows.map(r => r.url).filter(Boolean);\nreturn [{ json: { response: out, urls } }];"
      },
      "id": "format",
      "name": "Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/embeddings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": $json.embed_model, \"input\": $json.query } }}",
        "options": {}
      },
      "id": "697e4c1f-2c7e-4ae6-9995-32e15897c3cc",
      "name": "Embed Query (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        304
      ],
      "credentials": {
        "openRouterApi": {
          "id": "Xi9HFSqLS4FRotIs",
          "name": "ACR Website Chatbot - Embedding"
        }
      }
    }
  ],
