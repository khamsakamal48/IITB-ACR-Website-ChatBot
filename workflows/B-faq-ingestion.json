{
  "id": "lkwnBD6mt0QToQho",
  "name": "ACR KB — B: FAQ Ingestion (Sheet → Supabase)",
  "nodes": [
    {
      "id": "trigger",
      "name": "Daily / Manual",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": { "rule": { "interval": [ { "field": "days", "triggerAtHour": 2 } ] } }
    },
    {
      "id": "delfaq",
      "name": "Delete All FAQs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [220, 300],
      "executeOnce": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM documents WHERE metadata->>'source_type' = 'faq';",
        "options": {}
      }
    },
    {
      "id": "read",
      "name": "Read FAQ Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [440, 300],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "PUT_SPREADSHEET_ID_HERE" },
        "sheetName": { "__rl": true, "mode": "name", "value": "FAQs" },
        "options": {}
      }
    },
    {
      "id": "vstore",
      "name": "Insert to Supabase",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.3,
      "position": [700, 300],
      "parameters": {
        "mode": "insert",
        "tableName": { "__rl": true, "mode": "list", "value": "documents" },
        "options": { "queryName": "match_documents" }
      }
    },
    {
      "id": "emb",
      "name": "Embeddings (swap here)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [620, 520],
      "parameters": { "model": "text-embedding-3-small", "options": {} }
    },
    {
      "id": "loader",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [780, 520],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.question + '\\n' + $json.answer }}",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "source_type", "value": "faq" },
              { "name": "url", "value": "={{ $json.url }}" },
              { "name": "title", "value": "={{ $json.question }}" }
            ]
          }
        },
        "textSplittingMode": "simple"
      }
    }
  ],
  "connections": {
    "Daily / Manual": { "main": [ [ { "node": "Delete All FAQs", "type": "main", "index": 0 } ] ] },
    "Delete All FAQs": { "main": [ [ { "node": "Read FAQ Sheet", "type": "main", "index": 0 } ] ] },
    "Read FAQ Sheet": { "main": [ [ { "node": "Insert to Supabase", "type": "main", "index": 0 } ] ] },
    "Embeddings (swap here)": { "ai_embedding": [ [ { "node": "Insert to Supabase", "type": "ai_embedding", "index": 0 } ] ] },
    "Default Data Loader": { "ai_document": [ [ { "node": "Insert to Supabase", "type": "ai_document", "index": 0 } ] ] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  }
}
